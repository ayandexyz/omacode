# Vercel CLI uploads the whole monorepo when Root Directory is apps/web.
# apps/web only needs packages/ (workspace deps) and scripts/ (served by
# /install — see apps/web/app/lib/serve-script.ts); drop the other apps,
# bench data, and every build output so the archive stays small.
# This file applies to EVERY Vercel project in the repo, so never list an
# app that has its own project: apps/docs (Root Directory apps/docs) needs
# only packages/ too, and ignoring it left that build with no Next.js.
apps/android
apps/core
apps/tui
apps/tui-rs
apps/vscode
apps/web-app
bench
docs
evals
graft
schemas
**/node_modules
**/.next
**/dist
**/target
**/__pycache__
.env*
.turbo
.claude
.pnpm-store
.git
