// Codemode suite — A/B material for the codemode tool (spec
// docs/specs/2026-10-05-codemode.md §6). NOT part of the gate.
// Fan-out and large-output tasks, the shapes codemode exists for. Each writes
// its answer to answer.txt and an immutable check.mjs scores it, so an A/B
// compares correctness AND cost:
//
//   pnpm eval ab codemode --baseline env:FREECODE_CODEMODE=0 //     --candidate env:FREECODE_CODEMODE=1 --trials 5 --hypothesis "..."
//
// Sandboxed (files fixture → build mode, permission prompts answered inside
// the sandbox). Dependency-free: plain .mjs + node:assert.
{"id": "codemode-fanout-port-conflict", "prompt": "Two of the service configs in services/ claim the same port. Find them and write their names, sorted alphabetically and separated by a space, to answer.txt. Do not modify check.mjs.", "failureCategory": "tool-routing", "whyModelBacked": "Codemode A/B material (spec 2026-10-05-codemode.md \u00a76): the answer needs every file read and compared, which is a fan-out the model either does one call at a time or in one script; only a real turn shows which and what it costs.", "files": {"services/svc-a.json": "{\n  \"name\": \"svc-a\",\n  \"port\": 3041,\n  \"replicas\": 2,\n  \"owner\": \"infra\"\n}\n", "services/svc-b.json": "{\n  \"name\": \"svc-b\",\n  \"port\": 3019,\n  \"replicas\": 1,\n  \"owner\": \"web\"\n}\n", "services/svc-c.json": "{\n  \"name\": \"svc-c\",\n  \"port\": 3050,\n  \"replicas\": 4,\n  \"owner\": \"infra\"\n}\n", "services/svc-d.json": "{\n  \"name\": \"svc-d\",\n  \"port\": 3083,\n  \"replicas\": 2,\n  \"owner\": \"infra\"\n}\n", "services/svc-e.json": "{\n  \"name\": \"svc-e\",\n  \"port\": 3006,\n  \"replicas\": 4,\n  \"owner\": \"infra\"\n}\n", "services/svc-f.json": "{\n  \"name\": \"svc-f\",\n  \"port\": 3009,\n  \"replicas\": 1,\n  \"owner\": \"infra\"\n}\n", "services/svc-g.json": "{\n  \"name\": \"svc-g\",\n  \"port\": 3068,\n  \"replicas\": 1,\n  \"owner\": \"data\"\n}\n", "services/svc-h.json": "{\n  \"name\": \"svc-h\",\n  \"port\": 3012,\n  \"replicas\": 4,\n  \"owner\": \"infra\"\n}\n", "services/svc-i.json": "{\n  \"name\": \"svc-i\",\n  \"port\": 3046,\n  \"replicas\": 2,\n  \"owner\": \"infra\"\n}\n", "services/svc-j.json": "{\n  \"name\": \"svc-j\",\n  \"port\": 3074,\n  \"replicas\": 2,\n  \"owner\": \"web\"\n}\n", "services/svc-k.json": "{\n  \"name\": \"svc-k\",\n  \"port\": 3050,\n  \"replicas\": 4,\n  \"owner\": \"infra\"\n}\n", "services/svc-l.json": "{\n  \"name\": \"svc-l\",\n  \"port\": 3064,\n  \"replicas\": 1,\n  \"owner\": \"data\"\n}\n", "check.mjs": "import { readFileSync } from 'node:fs';\nimport assert from 'node:assert';\nconst got = readFileSync('answer.txt', 'utf8').trim().split(/\\s+/).join(' ');\nassert.equal(got, \"svc-c svc-k\");\nconsole.log('ok');\n"}, "verify": "node check.mjs", "immutable": ["check.mjs"], "expectMaxTurns": 20}
{"id": "codemode-large-log-filter", "prompt": "`node gen.mjs` prints a large request log. Count the ERROR lines with code=E42 and find the request id (the id=... value) of the FIRST such line. Write `<count> <id>` to answer.txt, e.g. `12 req-abc`. Do not modify check.mjs or gen.mjs.", "failureCategory": "large-output", "whyModelBacked": "Codemode A/B material (spec \u00a76): a 20k-line output whose answer is two values; whether the model filters it in a script, in a shell pipeline, or reads it into context is the behaviour being measured.", "files": {"gen.mjs": "let seed = 42;\nconst rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;\nconst levels = ['INFO', 'INFO', 'INFO', 'WARN', 'DEBUG', 'ERROR'];\nconst codes = ['E10', 'E42', 'E77'];\nfor (let i = 0; i < 20000; i++) {\n  const level = levels[Math.floor(rnd() * levels.length)];\n  const code = level === 'ERROR' ? ' code=' + codes[Math.floor(rnd() * codes.length)] : '';\n  const id = 'req-' + Math.floor(rnd() * 1e9).toString(36);\n  console.log(`2026-10-05T10:${String(Math.floor(i / 400)).padStart(2, '0')}:${String(Math.floor((i % 400) / 7)).padStart(2, '0')} ${level} id=${id}${code} handled request ${i}`);\n}\n", "check.mjs": "import { readFileSync } from 'node:fs';\nimport assert from 'node:assert';\nconst got = readFileSync('answer.txt', 'utf8').trim().split(/\\s+/).join(' ');\nassert.equal(got, \"966 req-f6fnm8\");\nconsole.log('ok');\n"}, "verify": "node check.mjs", "immutable": ["check.mjs", "gen.mjs"], "expectMaxTurns": 20}
{"id": "codemode-unused-exports", "prompt": "Which functions exported by lib/util.mjs are not imported by any module under src/? Write their names, sorted alphabetically and separated by spaces, to answer.txt. Do not modify check.mjs.", "failureCategory": "tool-routing", "whyModelBacked": "Codemode A/B material (spec \u00a76): cross-referencing one file's exports against every importer is a read-and-compare fan-out; only a real turn shows how many calls and tokens the model spends on it.", "files": {"lib/util.mjs": "export function parseDate(...args) {\n  return args[0];\n}\n\nexport function formatBytes(...args) {\n  return args[0];\n}\n\nexport function slugify(...args) {\n  return args[0];\n}\n\nexport function clamp(...args) {\n  return args[0];\n}\n\nexport function retry(...args) {\n  return args[0];\n}\n\nexport function debounce(...args) {\n  return args[0];\n}\n\nexport function chunk(...args) {\n  return args[0];\n}\n\nexport function uniq(...args) {\n  return args[0];\n}\n\nexport function pick(...args) {\n  return args[0];\n}\n\nexport function omit(...args) {\n  return args[0];\n}\n\n", "src/feature0.mjs": "import { retry, uniq } from '../lib/util.mjs';\n\nexport function run0(x) {\n  return [retry(x), uniq(x)];\n}\n", "src/feature1.mjs": "import { parseDate } from '../lib/util.mjs';\n\nexport function run1(x) {\n  return [parseDate(x)];\n}\n", "src/feature2.mjs": "import { formatBytes, retry, uniq } from '../lib/util.mjs';\n\nexport function run2(x) {\n  return [formatBytes(x), retry(x), uniq(x)];\n}\n", "src/feature3.mjs": "import { parseDate, retry } from '../lib/util.mjs';\n\nexport function run3(x) {\n  return [parseDate(x), retry(x)];\n}\n", "src/feature4.mjs": "import { parseDate, pick, retry } from '../lib/util.mjs';\n\nexport function run4(x) {\n  return [parseDate(x), pick(x), retry(x)];\n}\n", "src/feature5.mjs": "import { clamp, formatBytes, retry } from '../lib/util.mjs';\n\nexport function run5(x) {\n  return [clamp(x), formatBytes(x), retry(x)];\n}\n", "src/feature6.mjs": "import { pick, slugify } from '../lib/util.mjs';\n\nexport function run6(x) {\n  return [pick(x), slugify(x)];\n}\n", "src/feature7.mjs": "import { clamp, retry } from '../lib/util.mjs';\n\nexport function run7(x) {\n  return [clamp(x), retry(x)];\n}\n", "src/feature8.mjs": "import { formatBytes, slugify } from '../lib/util.mjs';\n\nexport function run8(x) {\n  return [formatBytes(x), slugify(x)];\n}\n", "src/main.mjs": "import { parseDate } from '../lib/util.mjs';\n\nexport default parseDate;\n", "check.mjs": "import { readFileSync } from 'node:fs';\nimport assert from 'node:assert';\nconst got = readFileSync('answer.txt', 'utf8').trim().split(/\\s+/).join(' ');\nassert.equal(got, \"chunk debounce omit\");\nconsole.log('ok');\n"}, "verify": "node check.mjs", "immutable": ["check.mjs"], "expectMaxTurns": 20}
{"id": "codemode-fanout-failing-tests", "prompt": "Run each test file in tests/ separately with node and write the names of the ones that fail (non-zero exit), without the .mjs extension, sorted and separated by spaces, to answer.txt. Do not modify check.mjs or the tests.", "failureCategory": "tool-routing", "whyModelBacked": "Codemode A/B material (spec \u00a76): eight independent shell runs whose only useful output is the exit code \u2014 the fan-out-and-filter shape codemode exists for, against a shell loop or eight separate calls.", "files": {"tests/t01.mjs": "import assert from 'node:assert';\nassert.equal(1 * 2, 2);\nconsole.log('done');\n", "tests/t02.mjs": "import assert from 'node:assert';\nassert.equal(2 * 2, 4);\nconsole.log('done');\n", "tests/t03.mjs": "import assert from 'node:assert';\nassert.equal(1 + 1, 3, 't03 fails');\nconsole.log('done');\n", "tests/t04.mjs": "import assert from 'node:assert';\nassert.equal(4 * 2, 8);\nconsole.log('done');\n", "tests/t05.mjs": "import assert from 'node:assert';\nassert.equal(5 * 2, 10);\nconsole.log('done');\n", "tests/t06.mjs": "import assert from 'node:assert';\nassert.equal(1 + 1, 3, 't06 fails');\nconsole.log('done');\n", "tests/t07.mjs": "import assert from 'node:assert';\nassert.equal(7 * 2, 14);\nconsole.log('done');\n", "tests/t08.mjs": "import assert from 'node:assert';\nassert.equal(1 + 1, 3, 't08 fails');\nconsole.log('done');\n", "check.mjs": "import { readFileSync } from 'node:fs';\nimport assert from 'node:assert';\nconst got = readFileSync('answer.txt', 'utf8').trim().split(/\\s+/).join(' ');\nassert.equal(got, \"t03 t06 t08\");\nconsole.log('ok');\n"}, "verify": "node check.mjs", "immutable": ["check.mjs", "tests/t01.mjs", "tests/t02.mjs", "tests/t03.mjs", "tests/t04.mjs", "tests/t05.mjs", "tests/t06.mjs", "tests/t07.mjs", "tests/t08.mjs"], "expectMaxTurns": 20}
